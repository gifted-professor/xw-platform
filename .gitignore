# xw-platform .gitignore — 与两旧仓保持一致的运行产物忽略规则
# 零第三方依赖；无 node_modules。

# 依赖
node_modules/
integrations/dsh-xw/.runtime/
integrations/dsh-xw/.runtime-debug/

# 运行产物
*.log
logs/
screenshots/
*.bak
runtime/
!config/runtime/
!config/runtime/*.json
*.db
*.db-journal
*.db-wal
*.db-shm

# 环境与密钥
.env
.env.*
!.env.example

# OS / 编辑器
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# XHS lab-only read-only entry local data (client token, receipts) — never commit
.xw-lab/
