# xhs-registry local secrets — copy to .env and fill.
# NEVER commit .env. Third-party handoff ships only this example file.

# Registry auth (install-registry-task.ps1 + remote API clients)
XHS_AGENT_TOKEN=replace-with-agent-token
XHS_HUMAN_TOKEN=replace-with-human-token
XHS_OBSERVER_TOKEN=
XHS_OPERATOR_TOKEN=
XHS_HUMAN_ACTOR=console

# Pilot actor used by /xw ops (must be in control-plane pilotActors allowlist)
XHS_ACTOR=replace-with-pilot-actor

# Registry base URL as seen by Mac-side bridges (Tailscale or LAN).
# On the Windows host itself, prefer http://127.0.0.1:17930
XHS_REGISTRY_URL=http://127.0.0.1:17930

# Optional Feishu bitable bridge (sync-feishu / feishu-to-* / douyin harvest). Leave blank if unused.
FEISHU_BASE_TOKEN=replace-with-base-token
FEISHU_IDENTITY_TABLE_ID=replace-with-identity-table-id
FEISHU_PRODUCT_TABLE_ID=replace-with-product-table-id
FEISHU_PRODUCT_VIEW_ID=replace-with-product-view-id
# Qingdao 闲鱼闲置默认链路（ops/feishu-to-xianyu-idle-publish.mjs）；必需，缺省回落 FEISHU_BASE_TOKEN
FEISHU_QINGDAO_BASE_TOKEN=
FEISHU_QINGDAO_TABLE_ID=tblQ1hKZgbNX65gD
FEISHU_QINGDAO_VIEW_ID=vewSOMU6fu
FEISHU_DOUYIN_TABLE_ID=replace-with-douyin-table-id
FEISHU_SSH_HOST=xhs-windows

# Optional runs root for observer screenshots / evidence
XHS_RUNS_ROOT=C:\Users\Public\xhs-agent-runs
