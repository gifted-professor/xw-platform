{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xhs.m0.known-debt.v1.schema.json",
  "title": "M0 known debt register",
  "description": "Debt observed but not fixed within M0. Each entry has a stable failureId, criticality, owner, tracking issue, expiry, the gates it blocks/allows while waived, and the waiverReason. A waiver auto-expires at expiresAt or when a blocked gate is reached — whichever comes first.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "baselineId", "capturedAt", "entries"],
  "properties": {
    "schemaId": { "const": "xhs.m0.known-debt.v1" },
    "schemaVersion": { "const": 1 },
    "baselineId": { "type": "string", "pattern": "^xw-m0-[0-9]{8}-r[0-9]+$" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "failureId", "critical", "owner", "issue", "expiresAt",
          "blocksGates", "allowsGates", "waiverReason"
        ],
        "properties": {
          "failureId": { "type": "string", "pattern": "^debt_[a-z0-9_-]+$" },
          "critical": { "type": "boolean" },
          "owner": { "type": "string", "minLength": 1 },
          "issue": { "type": "string", "minLength": 1 },
          "expiresAt": { "type": "string", "format": "date-time" },
          "blocksGates": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "allowsGates": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "waiverReason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}