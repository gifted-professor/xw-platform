{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xhs.m0.private-evidence.v1.schema.json",
  "title": "M0 private evidence (placeholder until B1)",
  "description": "Encrypted WIP forensic package receipt. The ciphertext SHA-256, age recipient fingerprint, file count, and restore verification conclusion are filled in at B1 (M0-0C) after the age-encrypted package is round-tripped through GPFS and restored on a disposable VM. Until then status stays pending_age and the encrypted fields are null. The plaintext package is never published.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId", "schemaVersion", "baselineId", "capturedAt", "status",
    "ciphertextSha256", "ageRecipientFingerprint", "fileCount",
    "restoreReceipt", "privatePackagePath"
  ],
  "properties": {
    "schemaId": { "const": "xhs.m0.private-evidence.v1" },
    "schemaVersion": { "const": 1 },
    "baselineId": { "type": "string", "pattern": "^xw-m0-[0-9]{8}-r[0-9]+$" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pending_age", "encrypted", "restore_failed", "verified"] },
    "ciphertextSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "ageRecipientFingerprint": { "type": ["string", "null"] },
    "fileCount": { "type": ["integer", "null"], "minimum": 0 },
    "restoreReceipt": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["result", "checkedAt"],
      "properties": {
        "result": { "enum": ["PASS", "FAIL"] },
        "checkedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      }
    },
    "privatePackagePath": { "type": ["string", "null"] }
  }
}