{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xhs:contract:adopt-batch:v1",
  "title": "Atomic adoption batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "batchId",
    "manifestSha256",
    "macBaseCommit",
    "files"
  ],
  "properties": {
    "schemaId": { "const": "xhs.adopt-batch.v1" },
    "schemaVersion": { "const": 1 },
    "batchId": { "type": "string", "minLength": 1 },
    "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "macBaseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "beforeSha256", "afterSha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "beforeSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "afterSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
