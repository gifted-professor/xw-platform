{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhs-registry.local/contracts/work-receipt.v2.json",
  "title": "Work receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "taskRunId",
    "planHash",
    "executionPlanHash",
    "capabilityContractHash",
    "capabilityContractHashAlgorithm",
    "implementationClosureHash",
    "operationKey",
    "authorizationDecisionId",
    "jobId",
    "controlPlaneRunId",
    "terminalStatus",
    "reconcileRequired",
    "nodeId",
    "nodeIndex",
    "shardId",
    "shardIndex",
    "shardKey",
    "attemptId",
    "attemptIndex",
    "workerId",
    "alias",
    "capabilityId",
    "technicalStatus",
    "businessStatus",
    "retryable",
    "startedAt",
    "finishedAt"
  ],
  "properties": {
    "schemaId": { "const": "xhs.work-receipt.v2" },
    "schemaVersion": { "const": 2 },
    "taskRunId": { "type": "string", "minLength": 1 },
    "planHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "executionPlanHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runtimeReleaseId": { "type": ["string", "null"] },
    "capabilityContractHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "capabilityContractHashAlgorithm": { "type": "string", "minLength": 1 },
    "implementationClosureHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "operationKey": { "type": "string", "minLength": 1 },
    "authorizationDecisionId": { "type": "string", "minLength": 1 },
    "jobId": { "type": ["string", "null"], "minLength": 1 },
    "controlPlaneRunId": { "type": ["string", "null"], "minLength": 1 },
    "terminalStatus": { "type": "string", "minLength": 1 },
    "reconcileRequired": { "type": "boolean" },
    "nodeId": { "type": "string", "minLength": 1 },
    "nodeIndex": { "type": "integer", "minimum": 0 },
    "shardId": { "type": "string", "minLength": 1 },
    "shardIndex": { "type": "integer", "minimum": 0 },
    "shardKey": { "type": "string", "minLength": 1 },
    "attemptId": { "type": "string", "minLength": 1 },
    "attemptIndex": { "type": "integer", "minimum": 0 },
    "workerId": { "type": "string", "minLength": 1 },
    "alias": { "type": "string", "pattern": "^0[1-4]$" },
    "capabilityId": { "type": "string", "minLength": 1 },
    "technicalStatus": { "enum": ["succeeded", "failed", "blocked", "ambiguous"] },
    "businessStatus": { "enum": ["accepted", "rejected", "not_evaluated", "ambiguous"] },
    "retryable": { "type": "boolean" },
    "output": {},
    "error": {},
    "startedAt": { "type": "string", "minLength": 1 },
    "finishedAt": { "type": "string", "minLength": 1 }
  }
}
