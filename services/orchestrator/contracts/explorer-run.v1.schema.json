{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xhs:contract:explorer-run:v1",
  "title": "Sealed Explorer run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "runId",
    "taskId",
    "actor",
    "app",
    "deviceId",
    "startedAt",
    "producerCommit",
    "releaseId",
    "policyMode",
    "evidenceMode",
    "effects",
    "artifacts",
    "evidenceDebt",
    "contractSha256"
  ],
  "properties": {
    "schemaId": { "const": "xhs.explorer-run.v1" },
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^run_" },
    "taskId": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "app": { "type": "string", "minLength": 1 },
    "deviceId": { "type": "string", "minLength": 1 },
    "accountRef": { "type": ["string", "null"] },
    "sessionId": { "type": ["string", "null"] },
    "leaseId": { "type": ["string", "null"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": ["string", "null"], "format": "date-time" },
    "producerCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "registryCommit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "releaseId": { "type": "string", "minLength": 1 },
    "policyMode": { "enum": ["legacy", "shadow", "nonpayment_v1"] },
    "evidenceMode": { "enum": ["legacy", "dual", "v1"] },
    "effects": { "type": "array", "items": { "type": "object" } },
    "artifacts": { "type": "array", "items": { "type": "object" } },
    "candidateFiles": { "type": "array", "items": { "type": "object" } },
    "evidenceDebt": { "type": "array", "items": { "type": "object" } },
    "cleanup": { "type": "object" },
    "privacy": { "type": "object" },
    "contractSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
