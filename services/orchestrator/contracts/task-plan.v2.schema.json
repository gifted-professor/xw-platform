{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xhs.task-plan.v2",
  "title": "XW multi-device task plan v2",
  "type": "object",
  "required": ["schemaId", "schemaVersion", "planId", "planHash", "requestKeyHash", "goal", "execution", "nodes", "reduce"],
  "properties": {
    "schemaId": { "const": "xhs.task-plan.v2" },
    "schemaVersion": { "const": 2 },
    "planId": { "type": "string", "pattern": "^plan_[a-f0-9]{64}$" },
    "planHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requestKeyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goal": { "type": "string", "minLength": 1 },
    "execution": {
      "type": "object",
      "required": ["maxWorkers", "perDeviceConcurrency", "sharedTransport", "allowReassign", "maxAttemptsPerShard"],
      "properties": {
        "maxWorkers": { "type": "integer", "minimum": 1, "maximum": 4 },
        "perDeviceConcurrency": { "const": 1 },
        "sharedTransport": { "const": "control_plane_serialized" },
        "allowReassign": { "type": "boolean" },
        "maxAttemptsPerShard": { "type": "integer", "minimum": 1, "maximum": 3 }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["nodeId", "nodeIndex", "dependsOn", "executor", "shards"],
        "properties": {
          "nodeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "nodeIndex": { "type": "integer", "minimum": 0 },
          "dependsOn": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "executor": {
            "type": "object",
            "required": ["kind", "capabilityId", "appId", "replaySafety", "effectClass", "resources"],
            "properties": {
              "kind": { "enum": ["typed_job", "session_workflow"] },
              "capabilityId": { "type": "string", "minLength": 1 },
              "workflowId": { "type": "string", "minLength": 1 },
              "appId": { "type": "string", "minLength": 1 },
              "replaySafety": { "enum": ["read_only", "replay_safe", "ambiguous_on_timeout"] },
              "effectClass": { "const": "none" },
              "resources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "expectedApp": { "type": "object" }
            },
            "allOf": [
              {
                "if": { "properties": { "kind": { "const": "session_workflow" } }, "required": ["kind"] },
                "then": {
                  "required": ["workflowId"],
                  "properties": {
                    "capabilityId": { "const": "xiaowei.explorer.primitive" }
                  }
                }
              },
              {
                "if": { "properties": { "kind": { "const": "typed_job" } }, "required": ["kind"] },
                "then": {
                  "not": { "required": ["workflowId"] }
                }
              }
            ],
            "additionalProperties": false
          },
          "shards": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["shardId", "shardIndex", "shardKey", "params", "placement"],
              "properties": {
                "shardId": { "type": "string", "minLength": 1 },
                "shardIndex": { "type": "integer", "minimum": 0 },
                "shardKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "params": { "type": "object" },
                "placement": {
                  "type": "object",
                  "properties": {
                    "alias": { "enum": ["01", "02", "03", "04"] },
                    "eligibleAliases": {
                      "type": "array",
                      "items": { "enum": ["01", "02", "03", "04"] },
                      "uniqueItems": true
                    }
                  },
                  "additionalProperties": false
                },
                "acceptance": { "type": "object" }
              },
              "additionalProperties": false
            }
          },
          "acceptance": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "reduce": { "type": "object" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
