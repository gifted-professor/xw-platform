{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xhs:contract:repair-source-checkpoint:v1",
  "title": "Windows source-only repair checkpoint for independent Mac review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "checkpointId",
    "proposalId",
    "proposalSha256",
    "attempt",
    "producedAt",
    "baseCommit",
    "resultCommit",
    "businessSemanticsChanged",
    "files",
    "diff",
    "tests",
    "scopeGuard",
    "secretScan",
    "evidenceDebt",
    "authority"
  ],
  "properties": {
    "schemaId": { "const": "xhs.repair-source-checkpoint.v1" },
    "schemaVersion": { "const": 1 },
    "checkpointId": { "type": "string", "pattern": "^repair_checkpoint_[0-9a-f]{24}$" },
    "proposalId": { "type": "string", "pattern": "^repair_[0-9a-f]{24}$" },
    "proposalSha256": { "$ref": "#/$defs/sha256" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 5 },
    "producedAt": { "type": "string", "format": "date-time" },
    "baseCommit": { "$ref": "#/$defs/gitSha" },
    "resultCommit": { "$ref": "#/$defs/gitSha" },
    "businessSemanticsChanged": { "const": false },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "beforeSha256", "afterSha256", "addedLines", "deletedLines"],
        "properties": {
          "path": { "$ref": "#/$defs/repoPath" },
          "beforeSha256": {
            "oneOf": [
              { "$ref": "#/$defs/sha256" },
              { "type": "null" }
            ]
          },
          "afterSha256": { "$ref": "#/$defs/sha256" },
          "addedLines": { "type": "integer", "minimum": 0 },
          "deletedLines": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalLines", "patchSha256"],
      "properties": {
        "totalLines": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "patchSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed", "evidenceSha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "passed": { "const": true },
          "evidenceSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "scopeGuard": { "$ref": "#/$defs/passReceipt" },
    "secretScan": { "$ref": "#/$defs/passReceipt" },
    "evidenceDebt": { "type": "array", "items": { "type": "object" } },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "actorRole", "reviewVerdictModified", "macWritePerformed", "deploymentPerformed", "deviceActions"],
      "properties": {
        "actorId": { "type": "string", "minLength": 1 },
        "actorRole": { "const": "windows_consumer" },
        "reviewVerdictModified": { "const": false },
        "macWritePerformed": { "const": false },
        "deploymentPerformed": { "const": false },
        "deviceActions": { "const": 0 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "repoPath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "passReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "evidenceSha256"],
      "properties": {
        "passed": { "const": true },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
