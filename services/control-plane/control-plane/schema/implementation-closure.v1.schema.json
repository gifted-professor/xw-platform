{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhs-device-agent.local/schema/implementation-closure.v1.json",
  "title": "Implementation closure v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "algorithm", "entries"],
  "properties": {
    "schemaId": { "const": "xhs.implementation-closure.v1" },
    "algorithm": { "const": "sha256-canonical-json-v1" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\.\\./)(?!/)(?!.*\\\\)(?!.*\\.\\./).+$"
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
