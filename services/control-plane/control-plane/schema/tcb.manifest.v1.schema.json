{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhs-device-agent.local/schema/tcb.manifest.v1.json",
  "title": "TCB manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "manifestId",
    "implementationClosureHash",
    "paths"
  ],
  "properties": {
    "schemaId": { "const": "xhs.tcb.manifest.v1" },
    "schemaVersion": { "const": 1 },
    "manifestId": { "type": "string", "minLength": 1 },
    "implementationClosureHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!\\.\\./)(?!/)(?!.*\\\\)(?!.*\\.\\./).+$"
      }
    },
    "capabilityIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "closure": { "$ref": "implementation-closure.v1.schema.json" }
  }
}
