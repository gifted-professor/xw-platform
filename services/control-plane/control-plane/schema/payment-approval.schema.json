{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xhs:contract:payment-approval:v1",
  "title": "One-time payment approval binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "commitId",
    "runId",
    "effectId",
    "app",
    "accountRef",
    "payeeRef",
    "amount",
    "currency",
    "targetControlFingerprint",
    "snapshotHash",
    "deviceId",
    "createdAt",
    "expiresAt",
    "purpose",
    "issuer",
    "signature"
  ],
  "properties": {
    "schemaId": { "const": "xhs.payment-approval.v1" },
    "schemaVersion": { "const": 1 },
    "commitId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "pattern": "^run_" },
    "effectId": { "type": "string", "minLength": 1 },
    "app": { "type": "string", "minLength": 1 },
    "accountRef": { "type": "string", "minLength": 1 },
    "payeeRef": { "type": "string", "minLength": 1 },
    "amount": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]{1,2})?$" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "targetControlFingerprint": { "type": "string", "minLength": 1 },
    "snapshotHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "deviceId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "purpose": { "const": "financial_commit" },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "role", "keyId", "allowlistVersion"],
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "role": { "const": "human" },
        "keyId": { "type": "string", "minLength": 1 },
        "allowlistVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "signature": { "type": "string", "minLength": 1 }
  }
}
