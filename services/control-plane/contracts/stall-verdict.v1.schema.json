{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xhs.stall-verdict.v1",
  "title": "xhs.stall-verdict.v1",
  "type": "object",
  "required": ["schemaId", "schemaVersion", "signalType", "hash"],
  "additionalProperties": true,
  "properties": {
    "schemaId": { "const": "xhs.stall-verdict.v1" },
    "schemaVersion": { "const": 1 },
    "signalType": {
      "type": "string",
      "enum": ["ui_stall", "progress_silence", "slow_progress", "contract_violation", "unknown"]
    },
    "llmEscalationRecommended": { "type": "boolean" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
