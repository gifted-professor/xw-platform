# OpenAI-compatible cloud vision endpoint. Never commit the real key.
VISION_API_URL=https://api.example.com/v1/chat/completions
VISION_API_KEY=replace-me
VISION_MODEL=replace-with-a-vision-model

# Optional: lark-cli reads its OAuth token from its own local configuration.
LARK_BASE_TOKEN=replace-with-base-token
LARK_TABLE_ID=replace-with-table-id

# Multi-agent control plane. Keep the device config untracked.
CONTROL_PLANE_EXPECTED_HOST=DESKTOP-3I1EVHE
CONTROL_PLANE_NODE_ID=DESKTOP-3I1EVHE
CONTROL_PLANE_NODE_VERSION=24.11.1
CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PORT=17920
CONTROL_PLANE_DEVICES_FILE=C:\path\to\xhs-device-agent\config\control-plane.devices.json
CONTROL_PLANE_DB=C:\Users\Public\xhs-agent-control\control.db
CONTROL_PLANE_RUNS_ROOT=C:\Users\Public\xhs-agent-runs
CONTROL_PLANE_LEGACY_MODE=audit

# Optional XHS rewrite provider. The key is environment-only and never placed in argv.
XHS_LLM_ENDPOINT=https://api.example.com/v1/chat/completions
XHS_LLM_KEY=replace-me
XHS_LLM_MODEL=replace-with-a-model
