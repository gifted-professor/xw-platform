{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xw:contract:skill-checkpoint:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "checkpointId",
    "skillRunId",
    "skillId",
    "skillVersion",
    "state",
    "seq",
    "createdAt",
    "ids"
  ],
  "properties": {
    "schemaId": { "const": "xw.skill.checkpoint.v1" },
    "schemaVersion": { "const": 1 },
    "checkpointId": { "type": "string", "minLength": 1 },
    "skillRunId": { "type": "string", "minLength": 1 },
    "skillId": { "type": "string", "minLength": 1 },
    "skillVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "state": { "type": "string", "minLength": 1 },
    "seq": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "integer", "minimum": 0 },
    "lastDurableStep": { "type": ["integer", "null"], "minimum": 0 },
    "exit": { "type": ["string", "null"] },
    "ids": { "$ref": "urn:xw:contract:skill-correlation-ids:v1" },
    "payload": { "type": ["object", "null"] }
  }
}
