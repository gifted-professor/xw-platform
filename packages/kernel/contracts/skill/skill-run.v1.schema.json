{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xw:contract:skill-run:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "skillRunId",
    "skillId",
    "skillVersion",
    "skillVersionRef",
    "state",
    "attempt",
    "ids",
    "createdAt",
    "updatedAt",
    "checkpointSeq",
    "recoveryRequired"
  ],
  "properties": {
    "schemaId": { "const": "xw.skill.run.v1" },
    "schemaVersion": { "const": 1 },
    "skillRunId": { "type": "string", "minLength": 1 },
    "skillId": { "type": "string", "minLength": 1 },
    "skillVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "skillVersionRef": { "$ref": "urn:xw:contract:skill-version-ref:v1" },
    "implementationMode": { "enum": ["agentic", "scripted", "hybrid", "subgraph"] },
    "state": {
      "enum": [
        "READY",
        "RUNNING",
        "WAITING_INPUT",
        "WAITING_EXTERNAL",
        "VERIFYING",
        "BLOCKED",
        "SUCCEEDED",
        "FAILED",
        "AMBIGUOUS",
        "CANCELLED"
      ]
    },
    "exit": {
      "type": ["string", "null"],
      "enum": [
        "COMPLETED",
        "CONTINUE",
        "REROUTE",
        "WAIT_HUMAN",
        "WAIT_EXTERNAL",
        "RETRY",
        "FALLBACK",
        "REPAIR_REQUIRED",
        "ABORTED",
        null
      ]
    },
    "exitReason": { "type": ["string", "null"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "ids": { "$ref": "urn:xw:contract:skill-correlation-ids:v1" },
    "createdAt": { "type": "integer", "minimum": 0 },
    "updatedAt": { "type": "integer", "minimum": 0 },
    "checkpointSeq": { "type": "integer", "minimum": 0 },
    "lastDurableStep": { "type": ["integer", "null"], "minimum": 0 },
    "lastExit": { "type": ["object", "null"] },
    "recoveryRequired": { "type": "boolean" },
    "actionLedgerRevision": { "type": ["integer", "null"], "minimum": 0 },
    "lastActionId": { "type": ["string", "null"] },
    "lastEffectId": { "type": ["string", "null"] },
    "lastVerifiedReceiptRef": { "type": ["string", "null"] },
    "harnessEventSeq": { "type": ["integer", "null"], "minimum": 0 }
  }
}
