{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xw:contract:execution-plan:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "planRunId",
    "skillId",
    "skillVersionRef",
    "requestedWorkers",
    "selectedWorkers",
    "shards",
    "join",
    "reduce"
  ],
  "properties": {
    "schemaId": { "const": "xw.execution.plan.v1" },
    "schemaVersion": { "const": 1 },
    "planRunId": { "type": "string", "minLength": 1 },
    "skillId": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
    "skillVersionRef": { "$ref": "urn:xw:contract:skill-version-ref:v1" },
    "requestedWorkers": { "type": "integer", "minimum": 1 },
    "selectedWorkers": { "type": "integer", "minimum": 0 },
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shardRunId", "input"],
        "properties": {
          "shardRunId": { "type": "string", "minLength": 1 },
          "input": { "type": "object" },
          "assignedDeviceId": { "type": ["string", "null"] }
        }
      }
    },
    "join": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waitPolicy"],
      "properties": {
        "waitPolicy": { "enum": ["all", "minimum", "quorum", "first", "best_effort"] },
        "minimum": { "type": "integer", "minimum": 1 }
      }
    },
    "reduce": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": { "type": "string", "minLength": 1 },
        "dedupeKey": { "type": "string", "minLength": 1 }
      }
    },
    "verification": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "minLength": 1 },
        "sampleRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
