{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xw:contract:open-action-observation:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "observationId",
    "deviceId",
    "deviceAlias",
    "sessionId",
    "capturedAt",
    "packageName",
    "activityName",
    "orientation",
    "viewport",
    "screenOn",
    "keyboardVisible",
    "screenshotRef",
    "screenshotSha256",
    "ocrRef",
    "accessibilityRef",
    "uiTreeRef",
    "elements",
    "pageHash",
    "paymentSignals",
    "evidenceRefs",
    "partial",
    "partialReason"
  ],
  "properties": {
    "schemaId": { "const": "xw.open-action.observation.v1" },
    "schemaVersion": { "const": 1 },
    "observationId": { "type": "string", "minLength": 1 },
    "deviceId": { "type": "string", "minLength": 1 },
    "deviceAlias": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "packageName": { "type": ["string", "null"] },
    "activityName": { "type": ["string", "null"] },
    "orientation": { "enum": ["portrait", "landscape", "unknown"] },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "screenOn": { "type": "boolean" },
    "keyboardVisible": { "type": "boolean" },
    "screenshotRef": { "type": ["string", "null"] },
    "screenshotSha256": { "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }] },
    "ocrRef": { "type": ["string", "null"] },
    "accessibilityRef": { "type": ["string", "null"] },
    "uiTreeRef": { "type": ["string", "null"] },
    "elements": { "type": "array", "items": { "type": "object" } },
    "pageHash": { "type": ["string", "null"] },
    "paymentSignals": { "type": "array", "items": { "type": "string" } },
    "paymentSignalSetVersion": { "type": "integer", "minimum": 1 },
    "paymentClassificationComplete": { "type": "boolean" },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } },
    "partial": { "type": "boolean" },
    "partialReason": { "type": ["string", "null"] }
  }
}
