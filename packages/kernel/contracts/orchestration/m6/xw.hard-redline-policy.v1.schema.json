{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xw:contract:m6:hard-redline-policy:v1",
  "title": "xw.hard-redline-policy.v1",
  "description": "Static hard-deny policy for payment and delete action categories. Multi-signal (OCR/semantic/resourceId/a11y label/icon label/page fingerprint/action intent); any hit is HARD_STOP, uncertainty on a risky page is REPLAN. Cannot be overridden by grants, models or live config.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "policyVersion",
    "policySha256",
    "categories",
    "riskPages",
    "signals",
    "uncertaintyRule"
  ],
  "properties": {
    "schemaId": { "const": "xw.hard-redline-policy.v1" },
    "policyVersion": { "type": "string", "minLength": 1 },
    "policySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "categories": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "synonyms"],
        "properties": {
          "name": {
            "enum": [
              "payment",
              "purchase",
              "transfer",
              "tip",
              "subscription",
              "credential-submit",
              "delete",
              "uninstall",
              "clear-data"
            ]
          },
          "synonyms": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "iconLabels": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "riskPages": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": ["confirm-dialog", "payment-page", "order-page", "assets-page", "destructive-settings"]
      }
    },
    "signals": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": ["ocr", "semantic", "resourceId", "a11yLabel", "iconLabel", "pageFingerprint", "actionIntent"]
      }
    },
    "uncertaintyRule": { "const": "REPLAN" }
  }
}
