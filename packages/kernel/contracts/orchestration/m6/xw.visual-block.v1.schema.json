{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xw:contract:m6:visual-block:v1",
  "title": "xw.visual-block.v1",
  "description": "A single model-visible visual block bound to exactly one immutable frameId. Pixel/normalized coordinates are forbidden at the schema layer; internal bounds live only behind an opaque boundsRef in the Grounding Runtime evidence store.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "frameId",
    "blockId",
    "stableIndex",
    "regionHash",
    "boundsRef",
    "label",
    "category",
    "confidence",
    "source"
  ],
  "properties": {
    "schemaId": { "const": "xw.visual-block.v1" },
    "frameId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "blockId": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Derived from frameId + stableIndex + regionHash; reuse across frames is detectable and invalid." },
    "stableIndex": { "type": "integer", "minimum": 0 },
    "regionHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "boundsRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "label": { "type": "string", "minLength": 1 },
    "category": {
      "enum": [
        "payment",
        "delete",
        "ads",
        "system-navigation",
        "status-bar",
        "keyboard",
        "permission-dialog",
        "content",
        "unknown"
      ]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": { "enum": ["ocr", "vision", "a11y", "resource-id", "fused"] }
  }
}
