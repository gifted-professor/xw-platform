{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xw:contract:m6:replay-corpus-manifest:v1",
  "title": "xw.replay-corpus-manifest.v1",
  "description": "Manifest for the M6 replay corpus. Every frame/evidence entry is content-addressed and must be deidentified, synthetic or explicitly authorized. Account IDs, device IDs, tokens, balances and similar sensitive fields are forbidden at the schema level.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "corpusId", "createdAt", "entries"],
  "properties": {
    "schemaId": { "const": "xw.replay-corpus-manifest.v1" },
    "schemaVersion": { "const": 1 },
    "corpusId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryId", "kind", "sha256", "bytes", "source", "license", "deidentified", "origin"],
      "propertyNames": {
        "not": { "pattern": "(?i)(account|device|serial|token|cookie|secret|password|balance|credential)" }
      },
      "properties": {
        "entryId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["frame", "screenshot", "dump", "focus", "evidence", "overlay"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "source": { "type": "string", "minLength": 1, "description": "Provenance: capture pipeline or generator that produced the asset." },
        "license": { "type": "string", "minLength": 1, "description": "Redistribution license or authorization reference." },
        "deidentified": { "const": true, "description": "Schema-level requirement: only deidentified assets may enter the corpus." },
        "origin": { "enum": ["synthetic", "authorized-capture"], "description": "Synthetic or captured under explicit authorization; nothing else is allowed." },
        "notes": { "type": "string" }
      },
      "not": {
        "anyOf": [
          { "required": ["accountId"] },
          { "required": ["deviceId"] },
          { "required": ["deviceSerial"] },
          { "required": ["token"] },
          { "required": ["balance"] },
          { "required": ["cookie"] },
          { "required": ["credential"] }
        ]
      }
    }
  }
}
