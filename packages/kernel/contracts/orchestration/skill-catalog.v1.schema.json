{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xw:contract:orchestration-skill-catalog:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "catalogId", "registrations"],
  "properties": {
    "schemaId": { "const": "xw.orchestration.skill-catalog.v1" },
    "schemaVersion": { "const": 1 },
    "catalogId": { "type": "string", "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$" },
    "registrations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registration" }
    }
  },
  "$defs": {
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillSpec",
        "skillVersionRef",
        "roles",
        "localValidator",
        "executor",
        "effectContract"
      ],
      "properties": {
        "skillSpec": { "$ref": "urn:xw:contract:skill-spec:v1" },
        "skillVersionRef": { "$ref": "urn:xw:contract:skill-version-ref:v1" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["collect", "search", "validate"] }
        },
        "localValidator": { "type": "boolean" },
        "executor": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "capabilityId"],
              "properties": {
                "kind": { "const": "capability" },
                "capabilityId": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "module", "exportName"],
              "properties": {
                "kind": { "const": "local" },
                "module": { "type": "string", "minLength": 1 },
                "exportName": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" }
              }
            }
          ]
        },
        "effectContract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "source"],
          "properties": {
            "class": { "enum": ["none", "reversible", "social", "publish", "payment", "delete"] },
            "source": { "enum": ["capability-contract", "local-validator"] }
          }
        }
      }
    }
  }
}
