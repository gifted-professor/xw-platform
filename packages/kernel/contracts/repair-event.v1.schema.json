{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xhs:contract:repair-event:v1",
  "title": "Append-only repair state event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "eventId", "proposalId", "proposalSha256", "eventType", "attempt", "occurredAt", "actor", "payload"],
  "properties": {
    "schemaId": { "const": "xhs.repair-event.v1" },
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "pattern": "^repair_event_[0-9a-f]{24}$" },
    "proposalId": { "type": "string", "pattern": "^repair_[0-9a-f]{24}$" },
    "proposalSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "eventType": {
      "enum": [
        "claim",
        "heartbeat",
        "start_fixing",
        "source_checkpoint",
        "review_approved",
        "review_request_changes",
        "mark_deployable",
        "start_replay",
        "complete",
        "attempt_failed",
        "fail",
        "claim_expired",
        "cancel"
      ]
    },
    "attempt": { "type": "integer", "minimum": 0, "maximum": 5 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["windows_consumer", "mac_governance", "human"] }
      }
    },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "eventType": { "const": "claim" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/claimPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "heartbeat" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/heartbeatPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "source_checkpoint" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/checkpointPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "enum": ["review_approved", "review_request_changes", "mark_deployable", "cancel"] } } },
      "then": { "properties": { "payload": { "required": ["authority"], "properties": { "authority": { "$ref": "#/$defs/macAuthority" } } } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "review_approved" } } },
      "then": { "properties": { "payload": { "required": ["reviewReceiptSha256"], "properties": { "reviewReceiptSha256": { "$ref": "#/$defs/sha256" } } } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "review_request_changes" } } },
      "then": { "properties": { "payload": { "required": ["reviewReceiptSha256", "findings", "expiresAt"], "properties": { "reviewReceiptSha256": { "$ref": "#/$defs/sha256" }, "findings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "expiresAt": { "type": "string", "format": "date-time" } } } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "mark_deployable" } } },
      "then": { "properties": { "payload": { "required": ["approvedEventId", "sourceCheckpointSha256", "resultCommit"], "properties": { "approvedEventId": { "type": "string", "pattern": "^repair_event_[0-9a-f]{24}$" }, "sourceCheckpointSha256": { "$ref": "#/$defs/sha256" }, "resultCommit": { "$ref": "#/$defs/gitSha" } } } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "start_replay" } } },
      "then": { "properties": { "payload": { "required": ["authorizationRef", "authorizationSha256", "authorizationCommit"], "properties": { "authorizationRef": { "type": "string", "pattern": "^docs/handoffs/repair-authorizations/" }, "authorizationSha256": { "$ref": "#/$defs/sha256" }, "authorizationCommit": { "$ref": "#/$defs/gitSha" } } } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "complete" } } },
      "then": { "properties": { "payload": { "required": ["bundleRef", "bundleSha256"], "properties": { "bundleRef": { "type": "string", "minLength": 1 }, "bundleSha256": { "$ref": "#/$defs/sha256" } } } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "claimPayload": {
      "type": "object",
      "required": ["expiresAt", "lockRef", "lockSha256"],
      "properties": {
        "expiresAt": { "type": "string", "format": "date-time" },
        "lockRef": { "type": "string", "pattern": "^repair/repair_[0-9a-f]{24}/attempt-[1-5]/claim\\.lock$" },
        "lockSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "heartbeatPayload": {
      "type": "object",
      "required": ["expiresAt", "lockSha256"],
      "properties": {
        "expiresAt": { "type": "string", "format": "date-time" },
        "lockSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "checkpointPayload": {
      "type": "object",
      "required": ["bundleSha256", "outboxRef"],
      "properties": {
        "bundleSha256": { "$ref": "#/$defs/sha256" },
        "outboxRef": { "type": "string", "minLength": 1 }
      }
    },
    "macAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["macCommit", "reviewReceiptPath", "reviewReceiptSha256", "reviewedCheckpointSha256"],
      "properties": {
        "macCommit": { "$ref": "#/$defs/gitSha" },
        "reviewReceiptPath": { "type": "string", "pattern": "^docs/handoffs/repair-reviews/" },
        "reviewReceiptSha256": { "$ref": "#/$defs/sha256" },
        "reviewedCheckpointSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    }
  }
}
