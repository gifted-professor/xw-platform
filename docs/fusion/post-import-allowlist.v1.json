{
  "schemaId": "xw.platform.fusion.post-import-allowlist.v1",
  "schemaVersion": 1,
  "title": "Post-import path allowlist — M3-B through M3-EH",
  "description": "fusion:verify subtracts only these exact paths. Blob and mode mismatches are separate. Missing imported files are never allowed. This is not a whole-tree relax and does not open runtime cutover.",
  "runtimeCutoverAllowed": false,
  "sourceFusionGate": "OPEN",
  "runtimeCutoverGate": "CLOSED",
  "services": {
    "orchestrator": {
      "allowedBlobModified": [
        "registry.mjs",
        "ops/xw-start.mjs",
        "package.json",
        "tests/xw-start.test.mjs"
      ],
      "allowedModeModified": [],
      "allowedExtra": [
        "ops/xw-repair.mjs"
      ]
    },
    "control-plane": {
      "allowedBlobModified": [
        "control-plane/lib/state-store.mjs",
        "control-plane/lib/control-plane.mjs",
        "control-plane/router.mjs",
        "tests/control-plane-placement.test.mjs",
        "tests/discovery-session-state.test.mjs",
        "tests/foundation-pr3-transport-boundary.test.mjs",
        "tests/discovery-session.test.mjs"
      ],
      "allowedModeModified": [],
      "allowedExtra": [
        "control-plane/lib/open-action-session.mjs",
        "control-plane/lib/payment-firewall.mjs",
        "control-plane/lib/open-action-executor.mjs",
        "tests/open-action-device-session.test.mjs",
        "tests/control-plane-payment-firewall.test.mjs",
        "tests/control-plane-open-action-executor.test.mjs",
        "tests/m3eh-open-action-runtime.test.mjs",
        "tests/fixtures/payment-firewall/cases.json"
      ]
    }
  }
}
